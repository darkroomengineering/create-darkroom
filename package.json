{
  "name": "create-darkroom",
  "version": "0.1.1",
  "description": "Scaffold a darkroom.engineering project — satus (Next.js) or novus (React Router) — with the integrations you pick",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-darkroom": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "bun ./src/index.ts",
    "check": "biome check && tsc --noEmit",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run check && bun run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@types/node": "^25.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkroomengineering/create-darkroom.git"
  },
  "homepage": "https://github.com/darkroomengineering/create-darkroom#readme",
  "keywords": [
    "create",
    "scaffold",
    "darkroom",
    "satus",
    "novus",
    "nextjs",
    "react-router"
  ],
  "packageManager": "bun@1.3.5"
}
