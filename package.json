{
  "name": "create-darkroom",
  "version": "0.2.0",
  "description": "Scaffold a darkroom.engineering project \u2014 satus (Next.js) or novus (React Router) \u2014 with the integrations you pick",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-darkroom": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "bun ./src/index.ts",
    "check": "biome check && tsc --noEmit && bun test",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run check && bun run build",
    "test": "bun test"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkroomengineering/create-darkroom.git"
  },
  "homepage": "https://github.com/darkroomengineering/create-darkroom#readme",
  "keywords": [
    "create",
    "scaffold",
    "darkroom",
    "satus",
    "novus",
    "nextjs",
    "react-router"
  ],
  "packageManager": "bun@1.3.5"
}
